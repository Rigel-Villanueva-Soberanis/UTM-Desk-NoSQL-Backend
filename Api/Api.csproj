<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Api</RootNamespace>
    <!-- Genera el XML de los comentarios /// para que Swagger los muestre -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- 1591: no exigir comentario en todo lo público -->
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AutoMapper" Version="16.2.0" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.15" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.14.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Application\Application.csproj" />
    <ProjectReference Include="..\Infrastructure\Infrastructure.csproj" />
  </ItemGroup>

  <!--
    Al compilar en Debug (▶ en Visual Studio) enciende Redis en Docker con docker-compose.yml.
    Si ya está encendido no hace nada. Requiere Docker Desktop abierto; si no lo está,
    solo muestra una advertencia y el proyecto compila igual.
  -->
  <PropertyGroup>
    <RaizSolucion>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/..'))</RaizSolucion>
  </PropertyGroup>

  <Target Name="IniciarRedisDocker" BeforeTargets="Build"
          Condition="'$(Configuration)' == 'Debug' And '$(DesignTimeBuild)' != 'true' And Exists('$(RaizSolucion)/docker-compose.yml')">
    <Message Importance="high" Text="Iniciando Redis (docker compose up -d)..." />
    <Exec Command="docker compose up -d" WorkingDirectory="$(RaizSolucion)" ContinueOnError="true" />
  </Target>

</Project>
